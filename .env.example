# ===== 平台服务 =====
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
# 平台对外身份（统一外壳 tool 字段）
TOOL_NAME=quality_inspection_agent
TOOL_VERSION=0.1.0

# ===== 数据库（唯一运行库＝MySQL；平台与能力写侧只按 MySQL 验收，决策 49-③/50 R1）=====
#      建库：mysql -u root -p < scripts/sql/init.sql
DATABASE_URL=mysql+aiomysql://qcapp:change-me@127.0.0.1:3306/quality_inspection
# LangGraph 检查点：PG 优先（官方生产后端），空则回退 SQLite 断点库（CHECKPOINTER_PATH）/ 内存
# —— 该 SQLite 只存人工复核断点，不是任务/能力库（决策 50 R3 明确保留）
# 示例：postgresql://user:pass@host:5432/qc_checkpoints
CHECKPOINTER_URL=
CHECKPOINTER_PATH=./data/state.db        # LangGraph 检查点（人工复核断点续跑；仅当 CHECKPOINTER_URL 为空时生效）
DATA_DIR=./data                          # 原始输入 / 报告 / artifact 落盘目录
RULES_DIR=./config/rules                 # 判级规则目录（YAML）

# 能力注册中心（纯 DB 驱动）：建表后先执行种子脚本注册能力，平台启动零文件依赖：
#   uv run python -m scripts.sync_capabilities
# 启停控制：UPDATE capability_registry SET status='disabled' WHERE capability_id='...'
#           （15s 内自动生效，或 POST /api/v1/capabilities/reload 立即生效）

# ===== 算法网关 =====
GATEWAY_REQUEST_TIMEOUT_S=60
GATEWAY_RETRY_TIMES=2
GATEWAY_CONCURRENCY=4
GATEWAY_BREAKER_THRESHOLD=5

# ===== RAGFlow 知识库 =====
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
# 检索/聊天数据集：唯一事实源 = config/rules/ragflow_chat.yaml 的 dataset_ids（env 不再配置）
# 重排序模型名（如 bge-reranker-v2-m3），留空跳过重排
RAGFLOW_RERANK_MODEL=
# 知识库对话助手：启动时按此 YAML 幂等创建/同步 chat（RAG 配置统一 config/rules/*.yaml）
RAGFLOW_CHAT_CONFIG_PATH=./config/rules/ragflow_chat.yaml
RAGFLOW_CHAT_STARTUP_ENABLED=true

# ===== MinIO 对象存储（内容寻址去重；endpoint 留空则降级为本地落盘）=====
# endpoint 示例：localhost:9000（不带 http:// 或 https://）
MINIO_ENDPOINT=
# 开发示例：minioadmin
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=qc-media-assets               # 专用桶，不存在自动创建
MINIO_SECURE=false                        # true = https

# ===== 大模型（DashScope，OpenAI 兼容协议；可选）=====
DASHSCOPE_API_KEY=
LLM_MODEL=
VLM_MODEL=
LLM_BASE_URL=

# ===== Qwen 能力（可选）=====
QWEN_USE=0
QWEN_BASE_URL=
QWEN_API_KEY=

# ===== LangSmith 追踪（可选：在 smith.langchain.com 看每次运行的完整流程）=====
# 填了 API Key 并开启后，固定图/ReAct 轨/会话轨的每个节点、每次 LLM/工具调用
# 都会作为 trace 上报；与 LangGraph Studio（langgraph dev）互补。
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=qualitycheckingagent
LANGSMITH_API_KEY=