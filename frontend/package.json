{
  "name": "quality-checking-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=../.pw-browsers playwright test",
    "test:e2e:headed": "PLAYWRIGHT_BROWSERS_PATH=../.pw-browsers playwright test --headed"
  },
  "dependencies": {
    "antd": "^5.20.0",
    "axios": "^1.7.0",
    "dayjs": "^1.11.0",
    "katex": "^0.18.4",
    "konva": "^9.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.10",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.26.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "utif2": "^4.1.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "mysql2": "^3.24.2",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
