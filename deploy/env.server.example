# ============================================================================
# 智能质检 Agent 平台 —— 服务器端 .env 模板（非容器化部署，B′）
# 用法：install_server.sh 自动放置为 /opt/agent/vision-agent/quality-agent/.env（600 权限），
#       修改所有 <...> 占位值后 systemctl start quality-agent。
# 注意：本文件由 systemd EnvironmentFile 加载 —— 值后面【不要】写行内注释，
#       注释一律独立成行（systemd 会把行内 # 当作值的一部分）。
# ============================================================================

# ===== 平台服务（80 已预留，见部署手册 §10.3）=====
API_HOST=0.0.0.0
API_PORT=80
LOG_LEVEL=INFO
TOOL_NAME=quality_inspection_agent
TOOL_VERSION=0.1.0

# ===== 数据库：复用 RAGFlow 套件的 MySQL（docker-mysql-1，localhost:3306，安全组不放行）=====
# 驱动必须是 aiomysql（平台为异步 SQLAlchemy；手册旧稿 pymysql 系笔误，已勘误）。
# 专用账号 qc_agent 由 deploy/sql/create_platform_user.sql 创建（勿用 root）。
DATABASE_URL=mysql+aiomysql://qc_agent:<平台专用密码>@localhost:3306/quality_inspection

# ===== LangGraph 检查点 =====
# 服务器暂无独立 PG 时留空 → 回退 SQLite（CHECKPOINTER_PATH，平台目录 data/ 下）
CHECKPOINTER_URL=
CHECKPOINTER_PATH=./data/state.db
DATA_DIR=./data
RULES_DIR=./config/rules

# ===== 算法网关 =====
# 联调期各能力 endpoint 通过 DB UPDATE 切到 http://<工具机IP>:1810X（同机则 127.0.0.1），
# 15s 热生效或 POST /api/v1/capabilities/reload；详见 deploy/README.md「能力端点切换」。
GATEWAY_REQUEST_TIMEOUT_S=60
GATEWAY_RETRY_TIMES=2
GATEWAY_CONCURRENCY=4
GATEWAY_BREAKER_THRESHOLD=5

# ===== RAGFlow（同机 Docker 套件，API 9380）=====
RAGFLOW_BASE_URL=http://localhost:9380
# 在服务器 RAGFlow UI（http://<服务器IP>:8080）「API」页生成；旧本地 key 不通用
RAGFLOW_API_KEY=<RAGFLOW_API_KEY>
RAGFLOW_RERANK_MODEL=
RAGFLOW_CHAT_CONFIG_PATH=./config/rules/ragflow_chat.yaml
RAGFLOW_CHAT_STARTUP_ENABLED=true

# ===== MinIO：复用 RAGFlow 套件的 silo（localhost:9000，安全组不放行）=====
# 凭据为 RAGFlow compose 的 MinIO 账密（出厂默认见部署手册 §7.2）；桶不存在自动创建
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=<MINIO_ACCESS_KEY>
MINIO_SECRET_KEY=<MINIO_SECRET_KEY>
MINIO_BUCKET=qc-media-assets
MINIO_SECURE=false

# ===== 大模型（可选；留空则报告解读降级为纯模板）=====
DASHSCOPE_API_KEY=
LLM_MODEL=
VLM_MODEL=
LLM_BASE_URL=

# ===== LangSmith（生产默认关闭）=====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=qualitycheckingagent
