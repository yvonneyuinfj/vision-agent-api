# tool.env 追加项（install_ai_tool.sh 会把 HOST/PORT/TOOL_NAME 追加在本文件之后）
# 语义与交付方 .env.example 一致；未列出的键走 server/config.py 的 PROJECT_ROOT 相对默认值
TZ=Asia/Shanghai
# 推理治理（交付方默认值，显式固定防漂移）
MAX_UPLOAD_BYTES=20971520
INFERENCE_TIMEOUT_SECONDS=30
MAX_CONCURRENT_DETECTIONS=1
YOLOX_MERGE_METHOD=wbf
# 报告 PDF 中文字体：入驻时先 fc-list :lang=zh 核查服务器字体；
# 命中 report_service.py 候选路径（wqy-microhei/Noto CJK）则无需设置本键，
# 否则随包提供字体文件并在此指定绝对路径（偏差记录见 README-fluorescence.md）
# REPORT_FONT_PATH=/usr/share/fonts/truetype/wqy/wqy-microhei.ttc
