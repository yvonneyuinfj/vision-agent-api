# ============================================================================
# 智能质检 Agent 平台 —— 园区网（纯内网）.env 模板
# 与 env.server.example（公网验证机 B′）的差异：
#   ① RAGFlow 改接所内既有实例（跨机 API）；对象存储为所内 Ceph（S3 协议，
#      minio SDK 直连）；② 大模型从阿里云 MaaS 公网端点改为所内模型网关
#      （OpenAI 兼容）；③ 平台运行库 MySQL 落部署机本机（所内达梦不适配，
#      决策 50 R1：唯一运行库＝MySQL）；
#   ④ 交付前端为工作区顶层 Vue3 深蓝版（同源 /api/v1 + history 模式，构建后植入
#      后端托管的 frontend/dist、由平台 18000 端口直出），故须配置登录鉴权（AUTH_*）；
#      平台监听端口固定为 18000（本智能体可用端口段 18000–18099），须与 install_server.sh
#      传入的 APP_PORT 一致（systemd ExecStart 的 --port 才是实际监听口）；
#   ⑤ 所有 <...> 占位必须由所内管理员提供，禁止残留公网地址（机器无外网路由，
#      残留会表现为长时间连接超时重试）。
# 用法：现场拷为 /opt/agent/vision-agent/quality-agent/.env 并填占位（chown qcagent + chmod 600）。
# 注意：systemd EnvironmentFile 加载 —— 值后面【不要】写行内注释。
# ============================================================================

# ===== 平台服务 =====
# 监听端口 18000：园区网本智能体可用端口段 18000–18099 的首个；高位端口（≥1024）
# 非 root 直接可绑，无需提权。须与 install_server.sh 的 APP_PORT 一致（取一为准）。
API_HOST=0.0.0.0
API_PORT=18000
LOG_LEVEL=INFO
TOOL_NAME=quality_inspection_agent
TOOL_VERSION=0.1.0

# ===== 登录鉴权（顶层 Vue3 前端 /login 页依赖，务必覆盖默认口令）=====
# 后端 app/core/config.py 有内置随机默认（auth_password/auth_secret），园区网生产
# 必须显式覆盖：AUTH_SECRET 变更会使既有会话 Cookie 失效（正常，重新登录即可）。
# 中间件仅拦截 /api/v1/*，auth 登录/健康检查豁免；前端同源带 httpOnly 会话 Cookie。
# 值【不要】写行内注释；密码避开 # & $ 等 systemd/shell 敏感字符。
AUTH_ENABLED=true
AUTH_USERNAME=<登录账号，如 qcadmin>
AUTH_PASSWORD=<登录密码，覆盖默认随机值>
AUTH_SECRET=<会话签名密钥，随机串，务必与默认不同>

# ===== 数据库：部署机本机 MySQL 裸装（目标机禁 Docker；官方 minimal tarball，bind 127.0.0.1）=====
# 建库 scripts/sql/init.sql + 建账号 deploy/sql/create_platform_user.sql（裸装形态 host 建议由 '%'
# 收敛为 'localhost'；安全边界靠 bind-address=127.0.0.1；Runbook §Step 5/§三）。驱动必须 mysql+aiomysql。
# 所内达梦：不适配（异步引擎无成熟 DM 驱动），如被要求入库则升级决策，勿直接改本行。
DATABASE_URL=mysql+aiomysql://qc_agent:<平台专用密码>@127.0.0.1:3306/quality_inspection

# ===== LangGraph 检查点 =====
# 所内无独立 PG 时留空 → 回退 SQLite（平台目录 data/ 下，仅存人工复核断点）
CHECKPOINTER_URL=
CHECKPOINTER_PATH=./data/state.db
DATA_DIR=./data
RULES_DIR=./config/rules

# ===== 算法网关（六工具同机 127.0.0.1:18011-18016，跨机改工具机 IP）=====
GATEWAY_REQUEST_TIMEOUT_S=60
GATEWAY_RETRY_TIMES=2
GATEWAY_CONCURRENCY=4
GATEWAY_BREAKER_THRESHOLD=5

# ===== RAGFlow：所内既有实例，API 接入 =====
# Base URL 端口为 RAGFlow API（默认 9380）；Key 在所内 RAGFlow UI「API」页新生成，
# 任何环境旧 key 均不通用。不可达时知识层自动降级（主链路不受影响）。
RAGFLOW_BASE_URL=http://<所内RAGFlow_IP>:9380
RAGFLOW_API_KEY=<RAGFLOW_API_KEY>
RAGFLOW_RERANK_MODEL=
RAGFLOW_CHAT_CONFIG_PATH=./config/rules/ragflow_chat.yaml
RAGFLOW_CHAT_STARTUP_ENABLED=true

# ===== 对象存储：所内 Ceph（S3 协议，minio SDK 直连）=====
# endpoint 格式：host:port，【不带 http:// 前缀】（minio SDK 约定）；
# RGW 开了 HTTPS 才改 MINIO_SECURE=true（自签证书需额外处理，现场确认）。
# 凭据若无建桶权限：请所内预建桶 qc-media-assets 并授读写（代码 ensure_bucket 幂等容错）；
# 整段留空 => 降级本地落盘 data/（报告产物不受影响，仅失去内容寻址去重）。
MINIO_ENDPOINT=<所内Ceph_RGW_IP>:<端口>
MINIO_ACCESS_KEY=<Ceph_ACCESS_KEY>
MINIO_SECRET_KEY=<Ceph_SECRET_KEY>
MINIO_BUCKET=qc-media-assets
MINIO_SECURE=false

# ===== 大模型：所内模型网关（OpenAI 兼容协议）=====
# 网关非 OpenAI 兼容或模型未定时：以下四行全部留空 → 报告解读退纯模板、
# agent 轨（VLM 自动识别）置灰，六工具检测主链路不受影响；后续热改本段 + restart 接入。
# 注意 LLM_BASE_URL 必须显式覆盖，不能让代码回退到 DashScope 公网默认地址。
DASHSCOPE_API_KEY=<网关密钥；无鉴权则填占位串 non-secret>
LLM_MODEL=<所内文本模型名，如 qwen2.5-72b-instruct>
VLM_MODEL=<所内视觉模型名，如 qwen2.5-vl-72b；无则留空>
LLM_BASE_URL=http://<网关IP>:<端口>/v1

# ===== LangSmith（园区网必关：外网追踪不可达）=====
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=qualitycheckingagent
